# Public site URL — used in sitemap, OG, robots. Set per-env in Vercel.
NEXT_PUBLIC_SITE_URL=https://creeksgirlslacrosse.com

# Gmail SMTP for the contact form. Generate an App Password at
# https://myaccount.google.com/apppasswords (the regular Gmail password
# will not work). 16 chars, no spaces.
GMAIL_USER=creeksgirlslacrosse@gmail.com
GMAIL_APP_PASSWORD=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — required for bootstrap role grants. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of emails that auto-receive the program_leader
# role on first sign-in (site-wide super-admin). After signup, this var
# stops having any effect.
# The old name BOOTSTRAP_HEAD_COACH_EMAILS is still read for back-compat.
BOOTSTRAP_PROGRAM_LEADER_EMAILS=
